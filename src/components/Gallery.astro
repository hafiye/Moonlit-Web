---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { shots: { img: ImageMetadata; full: string; alt: string }[] }
const { shots } = Astro.props;
---
<ul class="gallery">
  {shots.map((s) => (
    <li>
      <a href={s.full} data-full={s.full} data-alt={s.alt}>
        <Image src={s.img} alt={s.alt} widths={[480, 760]} sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 360px" loading="lazy" />
      </a>
    </li>
  ))}
</ul>

<dialog class="lightbox" aria-label="Screenshot">
  <form method="dialog"><button class="close" aria-label="Close">×</button></form>
  <img alt="" />
  <p class="caption"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dialog?.querySelector('img');
  const caption = dialog?.querySelector('.caption');
  document.querySelectorAll<HTMLAnchorElement>('.gallery a[data-full]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (!dialog || !img || !caption || typeof dialog.showModal !== 'function') return;
      e.preventDefault();
      img.src = a.dataset.full!;
      img.alt = a.dataset.alt ?? '';
      caption.textContent = a.dataset.alt ?? '';
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .gallery a { display: block; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); }
  .gallery img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform 0.4s ease; }
  .gallery a:hover img { transform: scale(1.03); }
  @media (max-width: 980px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .gallery { grid-template-columns: 1fr; } }

  .lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(1400px, 94vw);
    width: 100%;
    color: var(--text);
  }
  .lightbox::backdrop { background: rgba(10, 10, 10, 0.88); }
  .lightbox img { width: 100%; height: auto; max-height: 82vh; object-fit: contain; border-radius: 6px; }
  .caption { text-align: center; color: var(--muted); margin: 0.8rem 0 0; font-size: 0.95rem; }
  .close {
    position: fixed;
    top: 12px;
    right: 16px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
