---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'devlog'>[] }
const { posts } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<ul class="devlog-list">
  {posts.map((post) => (
    <li>
      <a class:list={['card', { 'no-cover': !post.data.cover }]} href={`/devlog/${post.id}/`}>
        {post.data.cover && (
          <Image src={post.data.cover} alt="" width={480} class="thumb" />
        )}
        <div class="body">
          <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span class="more">Read the devlog →</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .devlog-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .card {
    display: grid;
    grid-template-columns: minmax(0, 240px) 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card.no-cover { grid-template-columns: 1fr; }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .thumb { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; }
  time { font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  h3 { margin: 0.35rem 0 0.4rem; font-size: 1.4rem; }
  p { color: var(--muted); margin: 0 0 0.6rem; }
  .more { color: var(--accent-soft); font-size: 0.95rem; }
  @media (max-width: 640px) {
    .card { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
