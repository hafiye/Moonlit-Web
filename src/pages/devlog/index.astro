---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DevlogList from '../../components/DevlogList.astro';

const posts = (await getCollection('devlog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Devlog" description="Notes from the desk: how Moonlit Studios' games get made.">
  <section>
    <div class="wrap narrow">
      <span class="eyebrow">Devlog</span>
      <h1>Notes from the desk</h1>
      <p class="muted intro">
        How the games get made, what went wrong, and what I'm proud of. Follow along with <a href="/rss.xml">RSS</a>.
      </p>
      <DevlogList posts={posts} />
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 920px; }
  .intro { margin-bottom: 2.5rem; font-size: 1.1rem; }
</style>
